{
  "openapi": "3.1.0",
  "info": {
    "title": "Job Application Tracker API",
    "version": "1.1.0",
    "description": "Job Application Tracker API with Better Auth email/password authentication. Applications and resumes are private to the authenticated user. Better Auth is mounted at /api/auth and resource routes at /api/v1. Browser requests authenticate through Better Auth's session cookie; the optional Bearer scheme requires enabling the Better Auth Bearer plugin and represents a Better Auth session token, not necessarily a JWT. Every application/resume operation requires a valid session. Registration, sign-in, password recovery, and the session-check endpoint are callable without a session. Password reset email delivery requires a configured sendResetPassword callback. Use CSRF protections and trusted origins provided by Better Auth for cookie-authenticated requests."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    },
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Better Auth",
      "description": "Better Auth built-in email/password, user and session operations."
    },
    {
      "name": "Applications",
      "description": "Manage job applications."
    },
    {
      "name": "Resumes",
      "description": "Upload and manage resumes."
    }
  ],
  "paths": {
    "/api/auth/sign-up/email": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthSignUpEmail",
        "summary": "Register a new account",
        "description": "Better Auth email/password registration; requires emailAndPassword.enabled. A successful response may establish a session via Set-Cookie unless verification or autoSignIn settings disable it.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthSignUp"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSignInResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "422": {
            "description": "Credentials or input rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/email": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthSignInEmail",
        "summary": "Sign in with email and password",
        "description": "Better Auth email/password sign-in. On success, the server establishes a session in an HttpOnly cookie.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthSignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSignInResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "403": {
            "description": "Action is prohibited or account is unverified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthSignOut",
        "summary": "Sign out",
        "description": "Invalidates the current Better Auth session and clears its session cookie.",
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/get-session": {
      "get": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthGetSession",
        "summary": "Get active session",
        "description": "Returns user and session for a valid cookie (or supported bearer session). When not signed in, Better Auth may return HTTP 200 with null; this endpoint is intentionally callable without credentials.",
        "security": [],
        "responses": {
          "200": {
            "description": "Current session and user, or null if signed out.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BetterAuthSessionResult"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/request-password-reset": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthRequestPasswordReset",
        "summary": "Request password reset email",
        "description": "Sends password-reset link if the account exists. Requires emailAndPassword.sendResetPassword configuration. Do not expose whether an email address belongs to an account.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthRequestPasswordReset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthResetPassword",
        "summary": "Reset password using emailed token",
        "description": "Uses the one-time reset token sent to the user. No signed-in session is required.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthResetPassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "422": {
            "description": "Credentials or input rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthChangePassword",
        "summary": "Change current user password",
        "description": "Requires an authenticated Better Auth session and current password. Can revoke other sessions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthChangePassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "403": {
            "description": "Action is prohibited or account is unverified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/update-user": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthUpdateUser",
        "summary": "Update account profile",
        "description": "Updates the current authenticated user profile (name and/or image).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthUpdateUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/list-sessions": {
      "get": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthListSessions",
        "summary": "List active user sessions",
        "description": "Returns the active Better Auth sessions for the signed-in user.",
        "responses": {
          "200": {
            "description": "Active sessions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BetterAuthSession"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/revoke-session": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "operationId": "betterAuthRevokeSession",
        "summary": "Revoke a user session",
        "description": "Revokes a session owned by the current authenticated user using its session token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BetterAuthRevokeSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or session is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetterAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List applications",
        "operationId": "listApplications",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Optionally filter applications by status.",
            "schema": {
              "$ref": "#/components/schemas/ApplicationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of the current user's applications.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Create an application",
        "operationId": "createApplication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created.",
            "headers": {
              "Location": {
                "description": "URL of the created application.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ApplicationId"
        }
      ],
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Get an application by ID",
        "operationId": "getApplication",
        "responses": {
          "200": {
            "description": "The requested application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Applications"
        ],
        "summary": "Replace an application",
        "description": "Replace all client-editable fields of the application. Send a complete replacement representation: companyName, jobTitle and status are required. Omitted optional fields are cleared or reset to their defaults (for example, interviews becomes an empty array and resumeId becomes null). IDs and server timestamps cannot be changed.",
        "operationId": "updateApplication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationReplace"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Applications"
        ],
        "summary": "Delete an application",
        "operationId": "deleteApplication",
        "responses": {
          "204": {
            "description": "Application deleted; no response body."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/resumes": {
      "get": {
        "tags": [
          "Resumes"
        ],
        "summary": "List resumes",
        "operationId": "listResumes",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of the current user's resume metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Resumes"
        ],
        "summary": "Upload a resume",
        "description": "Accepts a PDF or DOCX resume as multipart/form-data.",
        "operationId": "createResume",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ResumeUpload"
              },
              "encoding": {
                "file": {
                  "contentType": "application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resume uploaded.",
            "headers": {
              "Location": {
                "description": "URL of the created resume metadata resource.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/resumes/{resumeId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ResumeId"
        }
      ],
      "get": {
        "tags": [
          "Resumes"
        ],
        "summary": "Get resume metadata by ID",
        "operationId": "getResume",
        "responses": {
          "200": {
            "description": "Metadata for the requested resume.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Resumes"
        ],
        "summary": "Delete a resume",
        "description": "Deletes the resume and its stored file. Applications referencing this resume are preserved and their resumeId is set to null.",
        "operationId": "deleteResume",
        "responses": {
          "204": {
            "description": "Resume deleted; no response body."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/resumes/{resumeId}/file": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ResumeId"
        }
      ],
      "get": {
        "tags": [
          "Resumes"
        ],
        "summary": "Download a resume file",
        "operationId": "downloadResume",
        "responses": {
          "200": {
            "description": "Resume file content in its original format.",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment disposition with original filename.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Default Better Auth signed session cookie; cookie name/prefix may vary with production configuration."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional Better Auth Bearer plugin. Send Authorization: Bearer <session-token>. This token is a Better Auth session token, not automatically a JWT. Enable the bearer plugin if this mode is needed."
      }
    },
    "parameters": {
      "ApplicationId": {
        "name": "applicationId",
        "in": "path",
        "required": true,
        "description": "UUID of an application belonging to the authenticated user.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ResumeId": {
        "name": "resumeId",
        "in": "path",
        "required": true,
        "description": "UUID of a resume belonging to the authenticated user.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-based).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of records returned per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "saved",
          "applied",
          "interviewing",
          "offered",
          "rejected",
          "withdrawn",
          "accepted"
        ]
      },
      "Interview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "scheduledAt"
        ],
        "properties": {
