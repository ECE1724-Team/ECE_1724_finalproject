DATABASE_URL=postgresql://localhost:5432/jobflow_dev
NODE_ENV=development
PORT=3000

# Authentication (Better Auth). BETTER_AUTH_URL is this backend's public origin.
BETTER_AUTH_URL=http://localhost:3000
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-private-random-secret
# Exact frontend origin(s), comma-separated.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Confirmed configuration: 7-day sessions; email links always last 900 seconds.
AUTH_SESSION_SECONDS=604800
AUTH_EMAIL_COOLDOWN_SECONDS=60
AUTH_EMAIL_WINDOW_SECONDS=900
AUTH_EMAIL_MAX_PER_WINDOW=5
AUTH_COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0

# Verification/reset email. Use your provider's SMTP settings, or a local SMTP catcher in development.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="JobFlow AI <no-reply@example.com>"
SMTP_USER=
SMTP_PASSWORD=

# Required for npm run test:db. Use a local test cluster and a role with CREATEDB.
# The suite connects here to create and drop its own temporary databases.
TEST_DATABASE_URL=

# Private Cloudflare R2 storage (backend only).
# Use your bucket's S3 endpoint, normally https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# No R2_PUBLIC_BASE_URL: PDF access goes through the authenticated backend.

# Explicit opt-in for npm run test:r2. Use ONLY an isolated development bucket.
# Otherwise the real R2 check is reported as skipped.
R2_INTEGRATION_TEST=0

# AI Copilot replies (OpenAI through the Vercel AI SDK, backend only). Leave the key empty to run
# without generation: workspaces and history still work, and sending a message answers 503.
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
# History compression (estimated tokens). Defaults 64000 and 16000; lower both only for a seeded demo.
AI_COMPRESS_AT_TOKENS=
AI_HISTORY_WINDOW_TOKENS=

# npm run seed (development only): demo account and its password (at least 8 characters).
SEED_EMAIL=avery.whitlock@example.com
SEED_PASSWORD=
