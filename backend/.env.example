DATABASE_URL=postgresql://localhost:5432/jobflow_dev

# Private Cloudflare R2 storage (backend only).
# Use your bucket's S3 endpoint, normally https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# No R2_PUBLIC_BASE_URL: PDF access goes through the authenticated backend.

# Operational settings, not product acceptance rules.
# Total attempts including the initial request; deadline includes retries and read streams.
R2_MAX_ATTEMPTS=3
R2_REQUEST_TIMEOUT_MS=30000

# Share one extractor instance per backend process; excess work returns "busy".
# Timeout terminates the worker. Memory limits cover V8 old-generation heap, not total RSS.
PDF_MAX_CONCURRENT=2
PDF_PARSE_TIMEOUT_MS=15000
PDF_WORKER_MEMORY_MB=256

# Explicit opt-in for npm run test:r2. Use ONLY an isolated development bucket.
# Otherwise the real R2 check is reported as skipped.
R2_INTEGRATION_TEST=0
