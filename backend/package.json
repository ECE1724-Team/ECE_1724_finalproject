{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/tests/unit/*.test.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --no-verbose",
    "test:db": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test --test-concurrency=1 dist/tests/tests/integration/*.db.test.js",
    "test:r2": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist/tests/tests/integration/r2.test.js"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "better-auth": "^1.7.20",
    "express": "^5.3.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
