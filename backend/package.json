{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/tests/unit/*.test.js dist/tests/tests/contract/*.test.js",
    "test:db": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env scripts/test-with-postgres.mjs",
    "test:r2": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist/tests/tests/integration/r2.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.mjs down",
    "seed": "npm run build && node --env-file-if-exists=.env seeds/demo.mjs"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai": "4.0.108",
    "@aws-sdk/client-s3": "3.1169.0",
    "@better-auth/core": "1.7.20",
    "ai": "7.0.162",
    "better-auth": "1.7.20",
    "cors": "2.8.6",
    "express": "^5.3.0",
    "jose": "6.2.17",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
